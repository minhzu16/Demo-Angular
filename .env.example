# ========================================================
# NexMart Environment Configuration Template
# Copy this file to .env and configure secret keys before running
# ========================================================

# Security / JWT (MUST be at least 256 bits / 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_256_bit_jwt_secret_key_here
JWT_EXPIRATION=900000

# Database Credentials
MYSQL_ROOT_PASSWORD=root_secure_password_123
MYSQL_USER=sa
MYSQL_PASSWORD=sa_secure_password_123

# SePay Payment Gateway
SEPAY_BANK_NAME=VietinBank
SEPAY_ACCOUNT_NUMBER=109874862892
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here

# RabbitMQ
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
